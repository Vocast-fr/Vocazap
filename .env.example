# --- Base de données ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://vocazap:change-me@db:5432/vocazap

# --- Pixeldrain (plusieurs clés séparées par des virgules : rotation hebdomadaire des comptes) ---
PIXELDRAIN_API_KEYS=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Rétention des piges (jours) ---
RETENTION_DAYS=30

# --- Recorder ---
# Dossier tampon local (heure en cours + heures en attente d'upload)
BUFFER_DIR=/data/buffer
# Limite d'uploads simultanés vers Pixeldrain
UPLOAD_CONCURRENCY=3

# --- API ---
PORT=3000
JWT_SECRET=change-me-long-random-string
ADMIN_PASSWORD=change-me
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=https://piges.vocast.fr,https://admin.piges.vocast.fr
# Seed automatique de data/radios.json si la table radios est vide
AUTO_SEED=true

# --- Fronts ---
# URL publique de l'API (utilisée par web et admin)
PUBLIC_API_URL=https://api.piges.vocast.fr
# URL publique du site (SEO / sitemap)
PUBLIC_WEB_URL=https://piges.vocast.fr

TZ=Europe/Paris
