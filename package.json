{
  "name": "vocazap",
  "private": true,
  "version": "2.0.0",
  "description": "Les piges radio - Vocast : enregistrement heure par heure des radios françaises et bibliothèque d'écoute",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @vocazap/api dev",
    "dev:recorder": "pnpm --filter @vocazap/recorder dev",
    "dev:web": "pnpm --filter @vocazap/web dev",
    "dev:admin": "pnpm --filter @vocazap/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @vocazap/db generate",
    "db:migrate": "pnpm --filter @vocazap/db migrate",
    "db:seed": "pnpm --filter @vocazap/db seed",
    "scrape:radios": "tsx scripts/scrape-fluxradios.mts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
